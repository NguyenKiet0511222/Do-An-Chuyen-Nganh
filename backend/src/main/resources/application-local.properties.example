# Copy file nay thanh application-local.properties (da duoc gitignore) roi sua theo may minh.
# Chay voi profile local (file nay duoc dong goi vao jar -> sua xong phai build lai):
#   mvnw.cmd -DskipTests package
#   java -jar target\backend-0.0.1-SNAPSHOT.jar --spring.profiles.active=local
# (hoac double-click run_backend.bat). KHONG dung "mvnw.cmd spring-boot:run": loi
# "Could not find or load main class" tren duong dan co dau tieng Viet/khoang trang.

# --- SQL Server (chay resources/db/01_create_database.sql + 02_users.sql truoc) ---
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=nongsan_db;encrypt=true;trustServerCertificate=true
spring.datasource.username=sa
spring.datasource.password=YourStrong!Passw0rd
# Ghi ro driver + dialect SQL Server (nhom da chot SQL Server, KHONG dung MySQL)
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver
spring.jpa.database-platform=org.hibernate.dialect.SQLServerDialect
# Neu dung Windows Authentication thay cho sa:
#spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=nongsan_db;encrypt=true;trustServerCertificate=true;integratedSecurity=true

# Bat khi can xem SQL Hibernate sinh ra
spring.jpa.show-sql=true

# --- Bao mat ---
app.jwt.secret=doi-thanh-chuoi-bi-mat-cua-ban-it-nhat-32-ky-tu
app.admin.email=admin@nongsan.local
app.admin.password=DoiMatKhauNay@123

# --- Dang nhap Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, loai Web) ---
app.google.client-id=xxxxxxxx.apps.googleusercontent.com

# --- AI service (cd ai && uvicorn ai.main:app --port 8000) ---
app.ai.base-url=http://localhost:8000
# May khong chay AI service: dat false de khoi cho timeout, moi anh moi vao hang cho admin kiem dinh
#app.ai.enabled=false
