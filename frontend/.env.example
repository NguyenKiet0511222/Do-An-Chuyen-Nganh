# Copy thành .env (đã gitignore). Frontend CHỈ gọi Spring Boot — không có biến trỏ thẳng tới AI service hay DB.
VITE_API_URL=http://localhost:8080/api

# Google OAuth Client ID cho nút "Đăng nhập bằng Google" — PHẢI trùng app.google.client-id của backend.
# Để trống -> nút Google hiện "chưa được cấu hình". Sửa xong phải chạy lại npm run dev.
VITE_GOOGLE_CLIENT_ID=
